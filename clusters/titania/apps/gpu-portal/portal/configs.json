{
  "state_namespace": "llm-serving",
  "configs": [
    {
      "id": "ornith",
      "name": "Ornith-1.5 35B-A3B",
      "kind": "LLM",
      "description": "128K context, tools and vision",
      "namespace": "llm-serving",
      "deployment": "intel-llama-ornith",
      "selector": "app.kubernetes.io/name=intel-llama-ornith",
      "variable": "ORNITH_REPLICAS",
      "kustomization": "llm-serving-intel-llama",
      "routes": ["qwen-intel", "sensitive", "local-first"],
      "stops": "qwen-intel, sensitive, /money and Open WebUI's default chat will stop. local-first falls back to DeepSeek.",
      "metrics": { "type": "llama", "url": "http://intel-llama-ornith.llm-serving.svc.cluster.local:8080/metrics" }
    },
    {
      "id": "swift",
      "name": "Swift Qwen3.8-27B Q3_K_M",
      "kind": "LLM",
      "description": "128K context, 43/49, 14.8 tok/s at 100K. First start downloads 14.5 GB",
      "namespace": "llm-serving",
      "deployment": "intel-llama-swift",
      "selector": "app.kubernetes.io/name=intel-llama-swift",
      "variable": "SWIFT_REPLICAS",
      "kustomization": "llm-serving-intel-llama",
      "routes": ["qwen-intel", "sensitive", "local-first"],
      "stops": "qwen-intel, sensitive, /money and Open WebUI's default chat will stop. local-first falls back to DeepSeek.",
      "metrics": { "type": "llama", "url": "http://intel-llama-ornith.llm-serving.svc.cluster.local:8080/metrics" }
    },
    {
      "id": "comfyui",
      "name": "ComfyUI with Chroma1-HD",
      "kind": "Image",
      "description": "imagine page, 60 to 70 s per image",
      "namespace": "comfyui",
      "deployment": "comfyui",
      "selector": "app.kubernetes.io/name=comfyui",
      "variable": "COMFYUI_REPLICAS",
      "kustomization": "comfyui",
      "routes": ["imagine", "comfyui"],
      "stops": "Image generation and the imagine page will stop.",
      "metrics": { "type": "comfyui", "url": "http://comfyui.comfyui.svc.cluster.local:8188/queue" }
    }
  ]
}
