{
  "name": "@homelab/autonomous-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded local Pi runner for reviewed repository pull requests",
  "bin": {
    "autonomous-agent": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test",
    "lint": "eslint src test",
    "check": "npm run typecheck && npm test && npm run lint"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "typebox": "1.3.7",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "eslint": "9.39.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.52.0",
    "vitest": "4.1.9"
  }
}
